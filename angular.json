{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "turnos-app": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "skipTests": true
        },
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "stylePreprocessorOptions": {
              "includePaths": ["src"]
            },
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kB",
                  "maximumError": "15kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "turnos-app:build:production"
            },
            "development": {
              "buildTarget": "turnos-app:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "providersFile": "src/test-providers.ts",
            "setupFiles": ["src/test-setup.ts"],
            "coverage": false,
            "coverageReporters": ["text", "html", "lcov"]
          },
          "configurations": {
            "ci": {
              "coverage": true,
              "coverageInclude": [
                "src/app/core/services/scroll-lock.service.ts",
                "src/app/core/services/auth.service.ts",
                "src/app/shared/components/search-input/search-input.component.ts",
                "src/app/core/interceptors/http-error.interceptor.ts",
                "src/app/core/interceptors/http-context.ts",
                "src/app/core/interceptors/auth.interceptor.ts",
                "src/app/core/guards/auth.guard.ts",
                "src/app/shared/directives/can.directive.ts",
                "src/app/core/auth/capabilities.ts",
                "src/app/core/auth/home-route.ts",
                "src/app/core/services/error-handler.service.ts",
                "src/app/core/services/notification.service.ts",
                "src/app/core/services/clinical-attention.service.ts",
                "src/app/features/odontograma/services/odonto-state.service.ts",
                "src/app/features/odontograma/services/odontograma-state.service.ts",
                "src/app/features/odontograma/services/perio-state.service.ts",
                "src/app/features/seguimiento/seguimiento-view/patient-data.service.ts",
                "src/app/features/historia-clinica/services/historia-clinica-state.service.ts",
                "src/app/core/utils/date.utils.ts",
                "src/app/core/utils/currency.util.ts",
                "src/app/core/utils/full-name.util.ts",
                "src/app/core/utils/anamnesis.util.ts",
                "src/app/core/utils/profesional-assignability.util.ts",
                "src/app/features/odontograma/services/odonto-delta.util.ts",
                "src/app/features/odontograma/services/perio-delta.util.ts",
                "src/app/features/seguimiento/utils/seguimiento-display.util.ts",
                "src/app/shared/validators/custom-validators.ts",
                "src/app/core/services/patient.service.ts",
                "src/app/core/services/profesional.service.ts",
                "src/app/core/services/appointments.service.ts",
                "src/app/core/services/configuration.service.ts",
                "src/app/core/services/dashboard.service.ts",
                "src/app/core/services/historia-clinica.service.ts",
                "src/app/core/services/invitation.service.ts",
                "src/app/core/services/module-rules.service.ts",
                "src/app/core/services/odontograma.service.ts",
                "src/app/core/services/periodontograma.service.ts",
                "src/app/features/coberturas/coberturas.service.ts",
                "src/app/features/coberturas/intermediarios.service.ts",
                "src/app/shared/directives/body-portal.directive.ts",
                "src/app/shared/directives/scroll-lock.directive.ts",
                "src/app/shared/components/mini-calendar-picker/mini-calendar-picker.component.ts",
                "src/app/features/patients/components/patient-combobox/patient-combobox.component.ts",
                "src/app/layout/navbar/navbar.component.ts",
                "src/app/shared/components/patient-form/patient-form.component.ts",
                "src/app/shared/components/patient-wizard/patient-wizard.component.ts",
                "src/app/features/appointments/components/appointment-dialog/appointment-dialog.component.ts",
                "src/app/features/appointments/components/appointments-panel/appointments-panel.component.ts",
                "src/app/features/appointments/components/confirm-dialog/confirm-dialog.component.ts",
                "src/app/features/appointments/pages/turnos-view/turnos-view.component.ts",
                "src/app/features/auth/login/login.component.ts",
                "src/app/features/calendar/components/month-calendar/month-calendar.component.ts",
                "src/app/features/coberturas/coberturas-view/coberturas-view.component.ts",
                "src/app/features/configuraciones/configuraciones-view/configuraciones-view.component.ts",
                "src/app/features/configuraciones/components/invitation-dialog/invitation-dialog.component.ts",
                "src/app/features/configuraciones/components/profesionales-panel/profesionales-panel.component.ts",
                "src/app/features/configuraciones/components/profesional-dialog/profesional-dialog.component.ts",
                "src/app/features/historia-clinica/components/historia-clinica-form/historia-clinica-form.component.ts",
                "src/app/features/odontograma/components/odontograma-form/odontograma-form.component.ts",
                "src/app/features/odontograma/components/perio-tooth-sparkline/perio-tooth-sparkline.component.ts",
                "src/app/features/odontograma/components/periodontograma-form/periodontograma-form.component.ts",
                "src/app/features/odontograma/components/save-odontograma-dialog/save-odontograma-dialog.component.ts",
                "src/app/features/panel/panel-view/panel-view.component.ts",
                "src/app/features/seguimiento/components/appointment-list-overflow/appointment-list-overflow.component.ts",
                "src/app/features/seguimiento/components/patient-wizard-panel/patient-wizard-panel.component.ts",
                "src/app/features/seguimiento/components/turn-clinical-modal/turn-clinical-modal.component.ts",
                "src/app/features/seguimiento/components/turn-payment-modal/turn-payment-modal.component.ts",
                "src/app/features/seguimiento/seguimiento-view/seguimiento-view.component.ts"
              ],
              "coverageThresholds": {
                "statements": 75,
                "branches": 75,
                "functions": 75,
                "lines": 75
              }
            }
          }
        }
      }
    }
  }
}
